// Guest output colour-grade pixel shader.
//
// Identical I/O contract to guest_output_bilinear_ps so it can sit in the
// same paint chain in place of bilinear final pass. Adds ASC-CDL style
// lift/gamma/gain + temperature shift + saturation control. cvar defaults
// give Downpour a subtle cinematic cool grade; users can disable by setting
// colour_grade_intensity=0 or by selecting a different swap_post_effect.
//
// 2026-06-22 fix: bake 8bpc ordered-blue-noise dither into the output so that
// banding does not appear at high resolution_scale (3, 4) where supersampled
// gradients quantize visibly in 8bpc swap chain. Same noise table xenia uses
// in dither_8bpc.xesli (XeBlueNoise16x16Values0Until256, 16x16 tile).
//
// Build:
//   fxc /T ps_5_1 /E main /O3 /Fh guest_output_colour_grade_ps.h
//       /Vn guest_output_colour_grade_ps guest_output_colour_grade_ps.hlsl

cbuffer push_consts_xe : register(b0) {
  int2  xe_bilinear_output_offset;     // 0  (matches BilinearConstants)
  float2 xe_bilinear_output_size_inv;  // 8
  // Colour grade params - all in linear [perceptual] space (no tonemap inside).
  float3 xe_cg_lift;                   // 16  shadow offset, 0..0.2 typical
  float  xe_cg_saturation;             // 28  0=greyscale 1=neutral 1.5=punchy
  float3 xe_cg_gain;                   // 32  highlight multiplier, ~1.0
  float  xe_cg_contrast;               // 44  ~1.0; >1 deepens blacks
  float3 xe_cg_gamma_inv;              // 48  per-channel gamma (HLSL pow)
  float  xe_cg_temperature;            // 60  -1=cool blue, +1=warm orange
  float3 xe_cg_tint;                   // 64  small additive tint (rgb)
  float  xe_cg_intensity;              // 76  0=no grade 1=full grade
};

SamplerState xe_bilinear_sampler : register(s0);
Texture2D<float4> xe_bilinear_source : register(t0);

static const float3 kLumaCoeff = float3(0.2126, 0.7152, 0.0722);  // Rec.709

