  (248.0/256.0 + (-0.5 + 0.5/256.0)) / 255.0, (158.0/256.0 + (-0.5 + 0.5/256.0)) / 255.0
};

float DitherOffset8bpc(uint2 pixel_coord) {
  uint2 t = pixel_coord & 15u;
  return kDither[t.y * 16u + t.x];
}

float3 ApplyGrade(float3 c) {
  // Lift: pull shadows toward xe_cg_lift colour.
  c = c + xe_cg_lift * (1.0 - c);

  // Gain on highlights (multiplicative).
  c = c * xe_cg_gain;

  // Contrast around mid-grey 0.5.
  c = (c - 0.5) * xe_cg_contrast + 0.5;

  // Gamma (per-channel).
  c = pow(max(c, 1.0e-5), xe_cg_gamma_inv);

  // Temperature: cool / warm shift along Plankian-ish blue<->orange axis.
  // Negative pushes blue/cyan (horror mood), positive warm orange.
  float3 warm_shift = float3(0.06, 0.015, -0.07) * xe_cg_temperature;
  c = c + warm_shift;

  // Additive tint.
  c = c + xe_cg_tint;

  // Saturation around luminance.
  float gray = dot(c, kLumaCoeff);
  c = lerp(float3(gray, gray, gray), c, xe_cg_saturation);

  return c;
}

float4 main(float4 pos : SV_Position) : SV_Target {
  // Same coordinate math as guest_output_bilinear_ps. Origin at pixel center.
  int2 pixel_coord = int2(pos.xy) - xe_bilinear_output_offset;
  float2 uv = (float2(pixel_coord) + 0.5) * xe_bilinear_output_size_inv;

  float3 source = xe_bilinear_source.SampleLevel(xe_bilinear_sampler, uv, 0.0).rgb;
  float3 graded = ApplyGrade(source);
  float3 final = lerp(source, graded, xe_cg_intensity);

  // Apply 8bpc ordered blue-noise dither before the saturate-and-store.
  // Replaces the fixed-function 0.5 rounding offset so banding becomes uniform
  // noise (matches xenia's XeDitherOffset8bpc). Adds at most 1/255 of noise
  // amplitude - imperceptible on its own, but breaks up gradient banding from
  // any operation that quantizes to 8bpc (FXAA luma, sRGB swap chain).
  float dither = DitherOffset8bpc(uint2(pos.xy));
  final = saturate(final + dither);

  return float4(final, 1.0);
}
