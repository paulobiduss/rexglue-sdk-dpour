// Guest output box-filter pixel shader.
//
// Drop-in replacement for guest_output_bilinear_ps when the source texture is
// LARGER than the output region (SSAA downsample). Solves the visible dither
// pattern users see when resolution_scale > 1 by integrating ALL source
// pixels in the output pixel's footprint with overlap-weighted averaging,
// instead of the 4-corner bilinear lerp which preserves the high-frequency
// alpha-test cross-hatch the X360 cook produces.
//
// I/O contract IDENTICAL to guest_output_bilinear_ps — uses the same
// BilinearConstants cbuffer (output_offset + output_size_inv). The source
// texture size is read at runtime via GetDimensions(), so no additional
// cbuffer field is required and the existing root signature works.
//
// For upsample (ratio < 1) the shader falls back to a single bilinear sample
// (the hardware sampler does the right thing). For 1:1 ratio it also reduces
// to a single sample. For downsample (ratio > 1) it loops over a box of
// source taps proportional to ratio (max 4x4 = 16 taps at ratio ≤ 3).
//
// Build (two variants from one source via XE_BOX_DITHER macro):
//   fxc /T ps_5_1 /E main /O3 /Fh guest_output_box_ps.h
//       /Vn guest_output_box_ps guest_output_box_ps.hlsl
//   fxc /T ps_5_1 /E main /O3 /DXE_BOX_DITHER=1
//       /Fh guest_output_box_dither_ps.h
//       /Vn guest_output_box_dither_ps guest_output_box_ps.hlsl

cbuffer push_consts_xe : register(b0) {
  int2   xe_bilinear_output_offset;     // 0  (matches BoxConstants prefix)
  float2 xe_bilinear_output_size_inv;   // 8
  float2 xe_box_source_size;            // 16 - source pixels W,H
  float2 xe_box_source_size_inv;        // 24 - 1.0 / source_size
};

SamplerState xe_bilinear_sampler : register(s0);
Texture2D<float4> xe_bilinear_source : register(t0);

#ifndef XE_BOX_DITHER
#define XE_BOX_DITHER 0
#endif

