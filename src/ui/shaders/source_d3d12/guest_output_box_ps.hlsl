  // Same coordinate math as guest_output_bilinear_ps. Origin at pixel center
  // in the active output region.
  int2 pixel_coord = int2(pos.xy) - xe_bilinear_output_offset;
  float2 out_uv_center = (float2(pixel_coord) + 0.5) * xe_bilinear_output_size_inv;

  // Source size now comes from the cbuffer (BoxConstants::source_size +
  // source_size_inv). Earlier draft used Texture2D::GetDimensions() which
  // could return surprising values depending on resource padding, producing
  // a wildly wrong ratio and the "ніби в 8х" magnification artifact at
  // resolution_scale > 1. The host passes the exact GuestOutputPaintFlow
  // source size — single source of truth.
  float2 source_size = xe_box_source_size;
  float2 source_size_inv = xe_box_source_size_inv;

  // Output region size in pixels (inverse of size_inv is the active output
  // width / height, which is what we paint into).
  float2 output_size = 1.0 / xe_bilinear_output_size_inv;
  // ratio = how many source pixels fit into one output pixel along each axis.
  // ratio > 1 means downsample. ratio < 1 means upsample.
  float2 ratio = source_size / output_size;

  float3 result;
  // For upsample / 1:1 take a single bilinear sample — proper averaging
  // requires more than one source pixel per output pixel, which doesn't
  // apply here, and bilinear gives smooth interpolation between source
  // pixels.
  if (ratio.x <= 1.0 + 1e-4 && ratio.y <= 1.0 + 1e-4) {
    result =
        xe_bilinear_source.SampleLevel(xe_bilinear_sampler, out_uv_center, 0.0).rgb;
  } else {
    // Center of the box in source-pixel coordinates.
    float2 src_center = out_uv_center * source_size;
    float2 half_ratio = 0.5 * ratio;
    float2 box_min = src_center - half_ratio;
    float2 box_max = src_center + half_ratio;

    // Integer tap range over the box. floor(box_min) is the leftmost touched
    // source pixel index; ceil(box_max) - 1 is the rightmost touched index.
    int2 tap_min = int2(floor(box_min));
    int2 tap_max = int2(ceil(box_max)) - 1;

    // Clamp the tap loop count to a hardcoded 6 per dimension to keep the
    // shader bounded for any reasonable resolution_scale (1..8). For
    // scale=2 with 1080p output, ratio ≈ 1.33 → 2..3 taps. For scale=4
    // with 1080p output, ratio ≈ 2.67 → 4 taps. The clamp protects against
    // pathological aspect mismatch (e.g. ultrawide window) producing huge
    // ratios that would melt the shader.
    const int kMaxTapsPerDim = 6;
    int taps_x = min(tap_max.x - tap_min.x + 1, kMaxTapsPerDim);
    int taps_y = min(tap_max.y - tap_min.y + 1, kMaxTapsPerDim);

    float4 sum = float4(0.0, 0.0, 0.0, 0.0);
    float weight_sum = 0.0;

    // Loop body sums each source pixel inside the box weighted by the area
    // overlap between [tx,tx+1]x[ty,ty+1] and [box_min, box_max].
    [loop]
    for (int dy = 0; dy < taps_y; ++dy) {
      int ty = tap_min.y + dy;
      float overlap_y =
          saturate(min(float(ty) + 1.0, box_max.y) - max(float(ty), box_min.y));
      if (overlap_y <= 0.0) {
        continue;
      }
      [loop]
      for (int dx = 0; dx < taps_x; ++dx) {
        int tx = tap_min.x + dx;
        float overlap_x =
            saturate(min(float(tx) + 1.0, box_max.x) - max(float(tx), box_min.x));
        if (overlap_x <= 0.0) {
          continue;
        }
        float weight = overlap_x * overlap_y;
        float2 sample_uv = (float2(tx, ty) + 0.5) * source_size_inv;
        float3 c =
            xe_bilinear_source.SampleLevel(xe_bilinear_sampler, sample_uv, 0.0).rgb;
        sum.rgb += c * weight;
        weight_sum += weight;
      }
    }

    result = sum.rgb / max(weight_sum, 1e-5);
  }

#if XE_BOX_DITHER
  // 8bpc ordered blue-noise dither (matches kBilinearDither / kColourGrade).
  float dither = DitherOffset8bpc(uint2(pos.xy));
  result = saturate(result + dither);
#endif

  return float4(result, 1.0);
}
